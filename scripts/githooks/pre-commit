#!/bin/sh
# Refuses a commit whose checks without a browser fail, or that carries a built file.
cd "$(git rev-parse --show-toplevel)" || exit 1
sh scripts/check.sh fast >/dev/null || { sh scripts/check.sh fast --force; exit 1; }
git diff --cached --quiet --diff-filter=AM -- promptbook.html promptbook-cast.html || { echo "promptbook.html and promptbook-cast.html are built files and are not committed. Run: git restore --staged promptbook.html promptbook-cast.html"; exit 1; }
