{
  "name": "promptbook",
  "version": "1.5.0",
  "private": true,
  "description": "A prompt book for theatre in one self-contained HTML file",
  "license": "MIT",
  "homepage": "https://marcovitalii.github.io/promptbook/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcoVitalii/promptbook.git"
  },
  "bugs": "https://github.com/MarcoVitalii/promptbook/issues",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium && git config core.hooksPath scripts/githooks",
    "build": "python3 build.py",
    "check": "sh scripts/check.sh full",
    "check:fast": "sh scripts/check.sh fast",
    "test": "sh scripts/check.sh full --force",
    "test:unit": "node test/run.js test/unit",
    "test:browser": "node test/run.js test",
    "site": "node scripts/site.js"
  },
  "devDependencies": {
    "marked": "18.1.1",
    "playwright": "1.64.0"
  }
}
